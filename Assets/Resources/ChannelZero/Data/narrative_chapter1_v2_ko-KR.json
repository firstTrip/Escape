    {"id":"CH1.LIVING.CHILD.DIALOGUE.INTRO_03","chapter":"CH1","room":"LivingRoom","target":"Living_Child","era":"2001","type":"dialogue","speaker":"아이","trigger":"next","priority":100,"once":true,"text":"아저씨가 아직 기억을 못 해요."},
