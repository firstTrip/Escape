    {"id":"PRO.ENTRY.REQUEST.DESC.BLANK","chapter":"PRO","room":"EntryHall","target":"Entry_Mail","era":"2001","type":"description","trigger":"inspect","priority":100,"once":false,"text":"날짜만 적힌 TV 수리 의뢰서. 증상과 의뢰인 정보는 비어 있다."},
